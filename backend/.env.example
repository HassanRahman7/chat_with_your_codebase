# ---------------------------------------------------------------------------
# Codebase AI - backend environment template
# Copy to `.env` and fill in real local values. Never commit `.env`.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=Codebase AI
API_PREFIX=/api
LOG_LEVEL=INFO

# Comma-separated. Add your LAN origin when running Vite with --host.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# PostgreSQL (create the database first, see backend/README.md)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/codebase_ai

# Local controlled storage (relative to backend/)
CHROMA_PERSIST_DIRECTORY=./storage/chroma
REPOSITORY_STORAGE_DIRECTORY=./storage/repositories
TEMPORARY_STORAGE_DIRECTORY=./storage/temporary
CHROMA_COLLECTION_NAME=code_chunks

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (select with LLM_PROVIDER=openrouter)
# Get an API key at https://openrouter.ai/settings/keys
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers (never secrets):
# OPENROUTER_SITE_URL=http://localhost:5174
# OPENROUTER_APP_NAME=Codebase AI


# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE=0.2

# Ingestion limits (safe local defaults)
MAX_REPOSITORY_SIZE_MB=200
MAX_FILE_SIZE_MB=1
MAX_REPOSITORY_FILES=5000
CLONE_TIMEOUT_SECONDS=300
MAX_GITHUB_URL_LENGTH=2048

# Code chunking
CHUNK_MAX_CHARS=4000
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_LINES=5

# Request limits
MAX_QUESTION_LENGTH=4000
LLM_TIMEOUT_SECONDS=60
CHAT_TIMEOUT_SECONDS=90
